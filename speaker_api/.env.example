# Model Configuration
MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
MODEL_VERSION=1.0
# MODEL_SAVEDIR=pretrained_models/spkrec-ecapa-voxceleb
# LOCAL_STRATEGY=copy_skip_cache  # symlink | copy | copy_skip_cache | no_link

# Audio Constraints
SAMPLE_RATE=16000
MAX_FILE_SIZE_MB=10
MIN_AUDIO_DURATION=1.0
MAX_AUDIO_DURATION=60.0
# Optional: explicit ffmpeg path. If empty, system ffmpeg or the bundled
# imageio-ffmpeg binary is used.
# FFMPEG_BINARY=C:/ffmpeg/bin/ffmpeg.exe

# Identification Logic
DEFAULT_SIMILARITY_THRESHOLD=0.25

# Transcription (Groq Whisper)
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
DEFAULT_LANGUAGE=ar

# YouTube Data API
API_KEY=your_youtube_api_key
YOUTUBE_SEARCH_URL=https://www.googleapis.com/youtube/v3/search

# Quran dataset (defaults to ../quran.json relative to the project)
# QURAN_JSON_PATH=D:/eqra/quran.json
