# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/eqra

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=eqra_token

# Python FastAPI service
PYTHON_API_URL=http://127.0.0.1:8000
PYTHON_API_TIMEOUT_MS=180000

# Frontend origin (used by CORS with credentials)
CLIENT_URL=http://localhost:5173

# First admin bootstrap (used by `npm run seed:admin` and on startup if empty)
ADMIN_EMAIL=admin@eqra.local
ADMIN_PASSWORD=ChangeMe123!

# Upload & validation
MAX_UPLOAD_MB=20
MIN_ANALYSIS_SECONDS=5
# Minimum ayah match score (0-100); below this the ayah is reported as not recognized
AYAH_MIN_SCORE=70

# YouTube result cache TTL (hours)
YOUTUBE_CACHE_TTL_HOURS=24

# Rate limits
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MINUTES=15
ANALYSIS_RATE_MAX=30
ANALYSIS_RATE_WINDOW_MINUTES=60
